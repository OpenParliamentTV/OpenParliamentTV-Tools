#! /bin/sh

# Update script for an OpenParliamentTV-Data-TW output directory.
#
# Pass 1 downloads (plenary meetings discovered by date over the last 14 days,
# their speech kinds and the official per-clip text), merges, links entities,
# applies the WhisperX timings and extracts entities.
#
# Pass 2 re-runs, with --rebuild, the already-published sessions for which
# pass 1 found newly published official text (listed in
# cache/tw-official-text-upgrades.txt): the publish guard refuses a changed
# transcript otherwise.

set -e

OUTPUT=${1?Missing output directory parameter (data base directory)}

CALLDIR="$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")"
UPGRADES="${OUTPUT}/cache/tw-official-text-upgrades.txt"

python3 "${CALLDIR}/workflow.py" --period=11 --retry-count=10 "$OUTPUT" \
    --download-original --merge-speeches --link-entities --align-sentences \
    --extract-entities

if [ -s "$UPGRADES" ]; then
    SESSIONS="$(tr -s '[:space:]' '|' < "$UPGRADES" | sed 's/^|//; s/|$//')"
    python3 "${CALLDIR}/workflow.py" --period=11 --retry-count=10 "$OUTPUT" \
        --rebuild --limit-session "^(${SESSIONS})$" \
        --merge-speeches --link-entities --align-sentences --extract-entities
    rm -f "$UPGRADES"
fi
