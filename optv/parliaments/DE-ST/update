#! /bin/sh

# Main update script - expects a data directory as the only argument.
# Period 9 (current WP) and the sample Sittings 1-3 are baked in.

OUTPUT=${1?Missing output directory parameter (data base directory)}

CALLDIR="$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")"

# --limit-session scopes the media/protocol download and merge/link/align/NER
# to the sample sittings. Override with --limit-session to widen.
python3 "${CALLDIR}/workflow.py" --period=9 \
    --limit-session '0900[1-3]' \
    --retry-count=20 \
    --download-original --merge-speeches \
    --link-entities --align-sentences --extract-entities \
    "${OUTPUT}"
