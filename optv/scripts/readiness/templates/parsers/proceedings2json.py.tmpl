"""Turn the raw proceedings of $code into ``original/proceedings/{session}-proceedings.json``.

One record per speech, its text as ``textContents[].textBody[].sentences[]``.
The rights fields come from the manifest (``optv.parliaments.get_rights``), the
language from ``optv.parliaments.get_language``, the agenda item's type from a
``classify_`` function in ``optv.shared.agenda_types``.

Run on its own: ``python -m optv.parliaments.$code.parsers.proceedings2json <data_dir>``.
"""

import argparse
import logging
from pathlib import Path

from optv.shared.cli import load_config, setup_logging

logger = logging.getLogger(__name__)

PARLIAMENT_ID = Path(__file__).resolve().parents[1].name


def parse_proceedings(config, args) -> None:
    raise NotImplementedError("$code: parsing the proceedings is not implemented yet")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("data_dir", type=Path)
    parser.add_argument("--debug", action="store_true")
    args = parser.parse_args()
    setup_logging(args.debug)
    parse_proceedings(load_config(PARLIAMENT_ID, args.data_dir), args)


if __name__ == "__main__":
    main()
