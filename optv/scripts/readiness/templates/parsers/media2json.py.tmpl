"""Turn the raw media files of $code into ``original/media/{session}-media.json``.

One record per speech with the fields the merger joins on.

Run on its own: ``python -m optv.parliaments.$code.parsers.media2json <data_dir>``.
"""

import argparse
import logging
from pathlib import Path

from optv.shared.cli import load_config, setup_logging

logger = logging.getLogger(__name__)

PARLIAMENT_ID = Path(__file__).resolve().parents[1].name


def parse_media(config, args) -> None:
    raise NotImplementedError("$code: parsing the media files is not implemented yet")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("data_dir", type=Path)
    parser.add_argument("--debug", action="store_true")
    args = parser.parse_args()
    setup_logging(args.debug)
    parse_media(load_config(PARLIAMENT_ID, args.data_dir), args)


if __name__ == "__main__":
    main()
