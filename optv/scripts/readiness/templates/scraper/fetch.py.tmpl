"""Fetch the originals of $code: the media feed and the proceedings.

Writes the raw source files to ``original/media`` and ``original/proceedings``,
named so that ``Config.sessions()`` finds one media file per session.

Honour ``args.limit_session`` (or a session flag of this parliament's own)
before the first request: a run for three sample sessions asks the source for
those sessions and nothing else. Send requests through
``optv.shared.http.PoliteHTTP``, which spaces and retries them.

Run on its own: ``python -m optv.parliaments.$code.scraper.fetch <data_dir> --limit-session <regex>``.
"""

import argparse
import logging
from pathlib import Path

from optv.shared.cli import load_config, setup_logging

logger = logging.getLogger(__name__)

PARLIAMENT_ID = Path(__file__).resolve().parents[1].name


def fetch_originals(config, args) -> None:
    raise NotImplementedError("$code: fetching the originals is not implemented yet")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("data_dir", type=Path)
    parser.add_argument("--period", type=int, default=None)
    parser.add_argument("--limit-session", default="", help="regex of the session keys to fetch")
    parser.add_argument("--force", action="store_true", help="fetch again what is already there")
    parser.add_argument("--debug", action="store_true")
    args = parser.parse_args()
    setup_logging(args.debug)
    fetch_originals(load_config(PARLIAMENT_ID, args.data_dir), args)


if __name__ == "__main__":
    main()
